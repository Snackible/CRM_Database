# Copy to .env.local for local work and set the same names in the Vercel project's Environment Variables.
# Never commit real values.

# --- Sign-in accounts: a Google Sheet (same layout as the Delivery Tracker users sheet) ---
# username | password | role (b2b, admin, master-admin, ops) | account_id | display_name | Email | Contact
# b2b and admin/master-admin can sign in to the CRM. Share the sheet with the service account below as EDITOR
# (read to sign in, write to register new users). Link: .../spreadsheets/d/<ACCOUNTS_SHEET_ID>/edit#gid=<ACCOUNTS_GID>
ACCOUNTS_SHEET_ID=
ACCOUNTS_GID=

# Only used when ACCOUNTS_SHEET_ID is empty (local trials): one shared password plus the person's name.
PORTAL_PASSWORD=
# 16+ random characters that sign the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Neon (or any Postgres) connection string. Leave empty locally to use the built-in PGlite database in .data/
DATABASE_URL=

# --- Google Sheet feed for customer order details (optional) ---
# Pull: the same service account the Delivery Tracker uses. Share the sheet with this address as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Scheduled pull (Vercel Cron sends this as a Bearer token to /api/sheets/sync-all). 16+ characters.
CRON_SECRET=
# Push from an Apps Script in the sheet to /api/ingest. 16+ characters.
INGEST_SECRET=

# Optional: Gemini lets the chat understand questions the built-in rules cannot read. It only works out which
# question was meant; every figure still comes from the database. Several keys may be comma-separated.
# Without a key, or when Gemini is busy or out of quota, the rule-based chat answers on its own.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
